# Discord application token from the Bot page. Never share this or commit it.
DISCORD_TOKEN=

# Right-click the server name with Developer Mode on, then Copy Server ID.
DISCORD_GUILD_ID=

# Right-click the channel that should hold the live feed, then Copy Channel ID.
DISCORD_CHANNEL_ID=

# Public multiplayer relay. Friends-only rooms are not included.
RELAY_URL=wss://web-production-79ef3.up.railway.app

# How often the feed message is refreshed. 15 to 120 seconds.
POLL_SECONDS=20
